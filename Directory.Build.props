<Project>
  <!-- One place for the target framework. .NET 10 is the current LTS release.
       To build with the .NET 8 SDK instead, change net10.0 to net8.0 here; nothing else needs to change. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
